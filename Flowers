#include <iostream>
using namespace std;

int main() {
    int n,l,m=1,c=0,ans;
    cin >> l >> n; 
    while(c<n){
        for(int i=0;i<m;i++){
             c += l;
             if(c>=n){
                 ans = i+1;
                 break;
             }
        }
        for(int i=l-1;i>0;i--){
            c += i;
            if(c>=n){
                 ans = m+l-i;
                 break;
            }
        }
        m += l;
    }
    cout << ans;
}
